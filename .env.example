# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-in-production-min-32-chars
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Database ──────────────────────────────────────────────────────────────────
# MVP: SQLite (aiosqlite). Change DATABASE_URL for Postgres in prod.
DATABASE_URL=sqlite+aiosqlite:///./brainecosystem.db
# Postgres example:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/brainecosystem

# ─── Redis (optional — comment out to disable caching) ─────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# ─── LLM Provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama          # ollama | llamacpp | openai_compat
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b        # swap to llama3.2:1b for low-RAM devices
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# ─── Vision / Multimodal (optional) ────────────────────────────────────────────
VISION_ENABLED=false
VISION_MODEL=llava:7b

# ─── Tenant / School Isolation ─────────────────────────────────────────────────
DEFAULT_TENANT_ID=demo-school-001
# In production, tenant IDs are derived from JWT or subdomain

# ─── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440      # 24 h

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json              # json | console

# ─── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_SIMULATOR=true
FEATURE_VISION=false
FEATURE_PARENT_REPORTS=true
FEATURE_SPACED_REPETITION=true
